PORT=5000
NODE_ENV=development

# REQUIRED. Long random text that signs login tokens. Generate yours with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never share it, never commit it, never reuse the example.
JWT_SECRET=

# REQUIRED. Your PostgreSQL connection. The server will NOT start without it.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/laundry_db
# Set to true if your hosted database requires SSL (Render, Neon, Supabase...)
DATABASE_SSL=false

# Website address(es) allowed to call the API (comma-separated)
CLIENT_URL=http://localhost:3000

COMMISSION_RATE=0.10
SERVICE_FEE=300.00
